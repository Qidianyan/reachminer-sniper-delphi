# ReachMiner-Sniper Environment Configuration Example
# SECURITY REDLINE: Never commit real private keys or live API keys to version control!
# All three EVM wallet addresses MUST match identically (SingleWalletGuard anti-Sybil lock).

DELPHI_NETWORK=competition-testnet
DELPHI_SIGNER_TYPE=private_key
DELPHI_WALLET_ADDRESS=0x000000000000000000000000000000000000dEaD
DELPHI_API_BOUND_WALLET=0x000000000000000000000000000000000000dEaD
DORAHACKS_BUIDL_WALLET=0x000000000000000000000000000000000000dEaD

# Set at runtime via secure shell environment only (never write raw key into tracked files):
DELPHI_PRIVATE_KEY_ENV_REF=SET_IN_RUNTIME_SHELL_ONLY
DELPHI_API_ACCESS_KEY=SET_IN_RUNTIME_SHELL_ONLY
DELPHI_API_BASE_URL=https://delphi-api.gensyn.ai
REACHMINER_LEDGER_PATH=./data/miner_ledger.db
